{
  "name": "worship-rig",
  "productName": "Worship Rig",
  "private": true,
  "version": "0.1.0",
  "description": "Live MIDI keys, pads and key drones for worship, ambient and lofi. Electron app + Chrome fallback.",
  "author": "Ryan Ye",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "serve": "node serve.mjs --open",
    "build:mac": "electron-builder --mac --arm64",
    "test:unit": "node --test \"test/unit/**/*.test.mjs\"",
    "test:shell": "node test/phase1/shell/run.mjs",
    "test": "node test/run-all.mjs --skip soak"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "playwright": "^1.56.0"
  },
  "build": {
    "appId": "com.ryan.worshiprig",
    "productName": "Worship Rig",
    "directories": {
      "app": ".",
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "app/**/*",
      "!app/js/engine/test.html",
      "!**/user-samples/**",
      "!app/samples/**/*.trim.wav",
      "README.md",
      "LICENSES.md",
      "docs/**/*.md"
    ],
    "afterPack": "build/afterPack.js",
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Worship Rig does not record the microphone; macOS asks because web audio can open input devices.",
        "LSMinimumSystemVersion": "12.0"
      }
    }
  }
}
