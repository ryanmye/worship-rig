# Module and test discovery (T00b; BUILD_PLAN "Rules": adding a module = adding files).

# rig_module_list(<base dir> <prefix> <output .inc>)
# One `RIG_MODULE(<id>)` line per <base dir>/**/*_register.cpp, id = <prefix> + path below <base dir> without
# `_register.cpp`, made a C identifier (e.g. src/fx/reverb_register.cpp -> fx_reverb; the file must define
# `void rig_register_fx_reverb(rig::Registry &)`). Rewritten only when the list changes.
function(rig_module_list base prefix out)
  file(GLOB_RECURSE _regs CONFIGURE_DEPENDS ${base}/*_register.cpp)
  list(SORT _regs)
  set(_content "// GENERATED by cmake/RigModules.cmake from ${base}/**/*_register.cpp. Do not edit.\n")
  foreach(_f ${_regs})
    file(RELATIVE_PATH _rel ${base} ${_f})
    string(REGEX REPLACE "_register\\.cpp$" "" _name "${_rel}")
    string(MAKE_C_IDENTIFIER "${prefix}${_name}" _id)
    string(APPEND _content "RIG_MODULE(${_id})\n")
  endforeach()
  file(CONFIGURE OUTPUT ${out} CONTENT "${_content}" @ONLY)
endfunction()

# rig_test_suites(<sources> <out var>): the distinct doctest TEST_SUITE("name") names found in the sources.
function(rig_test_suites sources out)
  set(_all "")
  foreach(_f ${sources})
    file(STRINGS ${_f} _lines REGEX "TEST_SUITE\\(\"[^\"]+\"\\)")
    foreach(_l ${_lines})
      string(REGEX MATCH "TEST_SUITE\\(\"([^\"]+)\"\\)" _m "${_l}")
      list(APPEND _all "${CMAKE_MATCH_1}")
    endforeach()
  endforeach()
  list(REMOVE_DUPLICATES _all)
  list(SORT _all)
  set(${out} "${_all}" PARENT_SCOPE)
endfunction()
