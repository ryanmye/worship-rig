# ctest probe.null: run rig-probe on miniaudio's null backend for a few seconds and validate the report's shape
# (the keys tools/mac/check.sh and the cloud read). The numbers are not checked: the null backend is a timer thread.
#   cmake -DPROBE=<rig-probe> -DOUT=<report.json> -P probe_check.cmake
cmake_minimum_required(VERSION 3.20)
foreach(v PROBE OUT)
  if(NOT DEFINED ${v})
    message(FATAL_ERROR "probe_check: -D${v}= is required")
  endif()
endforeach()
file(REMOVE "${OUT}")
execute_process(
  COMMAND "${PROBE}" --backend null --out "${OUT}" --buffers 64,128,256,512 --seconds 0.25 --settle 0.1
          --kinds synth,sampler --sampler kalimba --notes 0,1,2 --step-seconds 0.2 --step-settle 0.1
  RESULT_VARIABLE rc ERROR_VARIABLE progress TIMEOUT 150)
message(STATUS "rig-probe progress:\n${progress}")
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "rig-probe exited with ${rc}")
endif()
file(READ "${OUT}" j)

function(need path)  # need(<key> [<key|index> ...]): the member exists (any type, null allowed)
  string(JSON _t ERROR_VARIABLE _e TYPE "${j}" ${ARGV})
  if(_e)
    message(FATAL_ERROR "report: missing ${ARGV} (${_e})")
  endif()
endfunction()
function(need_type type)  # need_type(<NUMBER|STRING|BOOLEAN|ARRAY|OBJECT> <path...>)
  set(_p ${ARGV})
  list(REMOVE_AT _p 0)
  string(JSON _t ERROR_VARIABLE _e TYPE "${j}" ${_p})
  if(_e OR NOT _t STREQUAL type)
    message(FATAL_ERROR "report: ${_p} is ${_t}, expected ${type} ${_e}")
  endif()
endfunction()
function(need_positive)
  need_type(NUMBER ${ARGV})
  string(JSON _v GET "${j}" ${ARGV})
  if(NOT _v GREATER 0)
    message(FATAL_ERROR "report: ${ARGV} = ${_v}, expected > 0")
  endif()
endfunction()

need_type(STRING tool)
need_type(STRING backend)
string(JSON backend GET "${j}" backend)
if(NOT backend STREQUAL "Null")
  message(FATAL_ERROR "report: backend ${backend}, expected Null")
endif()
need_type(BOOLEAN muted)
need_type(OBJECT device)
need_positive(device sample_rate)
need(device core_audio)

need_type(ARRAY buffers)
string(JSON nb LENGTH "${j}" buffers)
if(NOT nb EQUAL 4)
  message(FATAL_ERROR "report: ${nb} buffer entries, expected 4")
endif()
math(EXPR last "${nb} - 1")
foreach(i RANGE ${last})
  foreach(k requested granted sample_rate callbacks period_us latency_ms)
    need_positive(buffers ${i} ${k})
  endforeach()
  foreach(k late_callbacks core_xruns callbacks_expected)
    need_type(NUMBER buffers ${i} ${k})
  endforeach()
  foreach(k p50 p99 max mean)
    need_type(NUMBER buffers ${i} render_us ${k})
  endforeach()
  need_type(BOOLEAN buffers ${i} clean)
  string(JSON req GET "${j}" buffers ${i} requested)
  string(JSON got GET "${j}" buffers ${i} granted)
  if(NOT req EQUAL got)  # the null backend grants what it is asked
    message(FATAL_ERROR "report: buffer ${req} granted ${got}")
  endif()
endforeach()
need_type(BOOLEAN d2_64_frames measured)
need(d2_64_frames safe)
need_type(STRING d2_64_frames reason)

need_type(OBJECT load_sweep kinds)
need_positive(load_sweep quantum_us)
foreach(kind synth sampler)
  string(JSON err ERROR_VARIABLE none GET "${j}" load_sweep kinds ${kind} error)
  if(NOT none)
    message(FATAL_ERROR "report: ${kind} sweep failed: ${err}")
  endif()
  need_type(ARRAY load_sweep kinds ${kind} steps)
  string(JSON ns LENGTH "${j}" load_sweep kinds ${kind} steps)
  if(ns LESS 2)
    message(FATAL_ERROR "report: ${kind} sweep has ${ns} steps")
  endif()
  need_positive(load_sweep kinds ${kind} steps 1 voices)
  need_positive(load_sweep kinds ${kind} steps 1 quantum_us p99)
  foreach(k per_voice_us max_voices_60 max_voices_80 measured_crossing_60)
    need(load_sweep kinds ${kind} ${k})
  endforeach()
  need(load_sweep kinds ${kind} fixed16_us p99)
endforeach()
need(auto_voice_limit_suggestion)
string(JSON at TYPE "${j}" auto_voice_limit_suggestion)
if(at STREQUAL "OBJECT")
  foreach(k desktop per_voice_us quantum_us)
    need_type(NUMBER auto_voice_limit_suggestion ${k})
  endforeach()
  need_type(NUMBER auto_voice_limit_suggestion current_provisional desktop)
endif()
need_type(ARRAY errors)
need_type(ARRAY warnings)
need_positive(seconds_total)
string(JSON ne LENGTH "${j}" errors)
if(ne GREATER 0)
  string(JSON errs GET "${j}" errors)
  message(STATUS "report errors (allowed on the null backend only when the sweep slope is flat): ${errs}")
  string(JSON e0 GET "${j}" errors 0)
  if(NOT e0 MATCHES "^auto_voice_limit_suggestion")
    message(FATAL_ERROR "report: ${errs}")
  endif()
endif()
message(STATUS "probe report OK (${OUT})")
